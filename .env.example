# Server
PORT=3000
FRONTEND_ORIGIN=https://leetlytics.onrender.com
SESSION_SECRET=replace-with-a-long-random-value
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://leetlytics.onrender.com/auth/github/callback
DB_PATH=backend/data/leetmatric.sqlite
# Set DATABASE_URL on Render/production to use durable PostgreSQL.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_SIZE=5
# Local docker-compose uses its own PostgreSQL service; production should use
# a managed PostgreSQL connection string.
POSTGRES_PASSWORD=local-development-only

# Optional AI study plans
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Optional GitHub API rate-limit improvement
GITHUB_TOKEN=

# ── Authentication Feature Flag & Configuration ──────────────────────────────
AUTH_ENABLED=false
APP_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email Service ('console' for local dev; 'resend' or 'brevo' for production)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=noreply@leetlytics.onrender.com
